# Jails fail2ban complémentaires à ban-path-explorer (issue #13).
# Installation :
#   sudo apt install fail2ban
#   sudo cp config/fail2ban/jail.d/ban-hackers.local /etc/fail2ban/jail.d/
#   sudo fail2ban-client -t && sudo systemctl restart fail2ban
#   sudo fail2ban-client status

[DEFAULT]
# Ajoutez vos IPs/plages d'administration (séparées par des espaces)
ignoreip = 127.0.0.1/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5
# Récidive : même paliers que ban-path-explorer (1 h, 24 h, 7 j, 30 j)
bantime.increment   = true
bantime.multipliers = 1 24 168 720
bantime.maxtime     = 30d

# Brute force SSH (y compris tentatives sans mot de passe / scans de clés)
[sshd]
enabled = true
mode    = aggressive

# Brute force HTTP Basic/Digest (401 répétés)
[apache-auth]
enabled = true

# User-agents de scanners/aspirateurs connus
[apache-badbots]
enabled  = true
maxretry = 1

# Tentatives d'exécution de scripts inexistants
[apache-noscript]
enabled = true

# Requêtes anormalement longues (débordements)
[apache-overflows]
enabled  = true
maxretry = 2

# Recherche de phpMyAdmin, wp-admin, etc.
[apache-botsearch]
enabled = true

# Shellshock
[apache-shellshock]
enabled  = true
maxretry = 1

# Requêtes bloquées par ModSecurity (si installé, voir README)
[apache-modsecurity]
enabled  = true
maxretry = 2

# Bannit 1 semaine, tous ports, une IP bannie 5 fois en 1 jour par n'importe quelle jail
[recidive]
enabled = true
